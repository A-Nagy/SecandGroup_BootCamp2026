@model List<Category>

@{
    ViewData["Title"] = "Categories Page";
}

<h1>@ViewData["Title"] </h1>
 
<br />

<a asp-action="Create" class="btn btn-success">Add New Category</a>

<br />
<br />

<table class="table table-bordered">
    <thead>
        <tr>
            <th>#</th>
            <th>Category Name</th>
            <th>Category Description</th>
         
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>@category.Description</td>
                
                <td>
                    <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-secondary">Details</a>
                    <a asp-action="Edit"    asp-route-id="@category.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete"  asp-route-id="@category.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
</table>

