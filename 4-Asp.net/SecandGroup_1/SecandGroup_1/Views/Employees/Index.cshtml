@model List<Employee>

 @{
    ViewData["Title"] = "Employees Page";
}

<h1>@ViewData["Title"] </h1>
@* 
<p>Employee ID     :@Model.Id      </p>
<p>Employee Name   :@Model.Name    </p>
<p>Employee Email  :@Model.Email   </p>
<p>Employee Salary :@Model.Salary  </p>
<p>Employee Phone  :@Model.Phone   </p>
<p>Employee Address:@Model.Address </p> *@

<br />

<a asp-action="Create" class="btn btn-success">Add New Employee</a>

<br />
<br />
    
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Employee ID</th>
            <th>Employee Name</th>
            <th>Employee Email</th>
            <th>Employee Salary</th>
            <th>Employee Phone</th>
            <th>Employee Address</th>
            <th>Department</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.Id</td>
                <td>@employee.Name</td>
                <td>@employee.Email</td>
                <td>@employee.Salary</td>
                <td>@employee.Phone</td>
                <td>@employee.Address</td>
                <td>@employee.Department?.Name</td>
                <td>
                    <a asp-action="Details" asp-route-id="@employee.Id" class="btn btn-secondary">Details</a>
                    <a asp-action="Edit"    asp-route-id="@employee.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete"  asp-route-id="@employee.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
</table>
 
 